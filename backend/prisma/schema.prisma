// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  //output   = "../generated/prisma"
  //added because of nest-prisma documentation (v7 prisma version)
  moduleFormat    = "cjs"
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

//profile picture is missing
model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String         @unique
  password       String
  biography      String?
  preferences    Preference[]
  userLocations  UserLocation[] @ignore
  posts          Post[]
  postsLiked     PostLiked[]
  postsDisliked  PostDisliked[]
  //prisma es una mierda, ejemplo 1:
  friendsAsUser1 Friends[]      @relation("friend1") @ignore
  friendsAsUser2 Friends[]      @relation("friend2") @ignore

  comments Comment[]
  postScore PostScore[]

  events Event[]
  eventSignUp EventSignUp[]
  eventEntries EventEntry[]
}

model Sport {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  preferences Preference[] @ignore
  postSport PostSport[] @ignore
}

model Preference {
  id      Int    @id @default(autoincrement())
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)
  sportId Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  level   String

  //hace que la combinacion user-sport sea unica
  @@unique([userId, sportId])
}

model UserLocation {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId Int
}

model Location {
  id            Int            @id @default(autoincrement())
  location      String
  latitude      Float
  longitude     Float
  userLocations UserLocation[] @ignore

  events Event[]
}

model Post {
  id            Int            @id @default(autoincrement())
  content       String
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  postsLiked    PostLiked[]
  postsDisliked PostDisliked[]
  comments      Comment[]
  postSport PostSport[]
  postScore PostScore[]

  imagePosts ImagePost[]
}

model PostLiked {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@unique([postId, userId])
}

model PostDisliked {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@unique([postId, userId])
}

model Friends {
  id      Int    @id @default(autoincrement())
  user1   User   @relation("friend1", fields: [sender], references: [id], onDelete: Cascade)
  sender   Int
  user2    User   @relation("friend2", fields: [receiver], references: [id], onDelete: Cascade)
  receiver Int
  state    String

  @@unique([sender, receiver])
}

model CommentButton {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  parentId  Int?
  parent    Comment?  @relation("parent", fields: [parentId], references: [id])
  comments  Comment[] @relation("parent")
  content   String
  createdAt DateTime  @default(now())
}
model PostSport {
  id Int @id @default(autoincrement())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  sportId Int
  @@unique([postId, sportId])
}

model PostScore {
  id Int @id @default(autoincrement())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  sportMatch Int @default(0)
  @@unique([userId, postId])
}

model Image{
  id Int @id @default(autoincrement())
  url String

  imagePosts ImagePost[]
  imageEvents ImageEvent[]
  imageEntry ImageEntry[]
}

model ImagePost{
  id Int @id @default(autoincrement())
  imageId Int
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([imageId, postId])
}

model ImageEvent{
  id Int @id @default(autoincrement())

  imageId Int
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  eventId Int
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  description String

  @@unique([imageId, eventId])
}

model Event{
  id Int @id @default(autoincrement())
  hostId Int
  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title String
  description String
  chatId Int? //falta la tabla chat
  startingDate DateTime
  locationId Int?
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  endingDate DateTime?
  eventType EventType
  imageEvents ImageEvent[]
  eventSignUp EventSignUp[]
  isPrivate Boolean
  eventEntries EventEntry[]
}

enum EventType{
  Asynchronous
  InPerson
}

model EventSignUp {
  id Int @id @default(autoincrement())
  eventId Int
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  state String
  joinedAt DateTime?
  @@unique([userId, eventId])
}

model EventEntry {
  id        Int          @id @default(autoincrement())
  eventId   Int
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime     @default(now())
  images    ImageEntry[]
}

model ImageEntry {
  id          Int        @id @default(autoincrement())
  imageId     Int
  image       Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  entryId     Int
  entry       EventEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

