// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  //output   = "../generated/prisma"
  //added because of nest-prisma documentation (v7 prisma version)
  moduleFormat    = "cjs"
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

//profile picture is missing
model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String         @unique
  password       String
  biography      String?
  preferences    Preference[]   @ignore
  userLocations  UserLocation[] @ignore
  posts          Post[]
  postsLiked     PostLiked[]    @ignore
  postsDisliked  PostDisliked[] @ignore
  //prisma es una mierda, ejemplo 1:
  friendsAsUser1 Friends[]      @relation("friend1") @ignore
  friendsAsUser2 Friends[]      @relation("friend2") @ignore
}

model Sport {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  preferences Preference[] @ignore
}

model Preference {
  id      Int    @id @default(autoincrement())
  sport   Sport  @relation(fields: [sportId], references: [id])
  sportId Int
  user    User   @relation(fields: [userId], references: [id])
  userId  Int
  level   String

  //hace que la combinacion user-sport sea unica
  @@unique([userId, sportId])
}

model UserLocation {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  location   Location @relation(fields: [locationId], references: [id])
  locationId Int
}

model Location {
  id            Int            @id @default(autoincrement())
  location      String
  latitude      Float
  longitude     Float
  userLocations UserLocation[] @ignore
}

model Post {
  id            Int            @id @default(autoincrement())
  content       String
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])
  userId        Int
  postsLiked    PostLiked[]
  postsDisliked PostDisliked[]
}

model PostLiked {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id])
  postId Int
  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([postId, userId])
}

model PostDisliked {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id])
  postId Int
  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([postId, userId])
}

model Friends {
  id      Int    @id @default(autoincrement())
  user1   User   @relation("friend1", fields: [sender], references: [id])
  sender   Int
  user2    User   @relation("friend2", fields: [receiver], references: [id])
  receiver Int
  state    String

  @@unique([sender, receiver])
}
