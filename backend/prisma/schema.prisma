// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  // output   = "../generated/prisma"
  // added because of nest-prisma documentation (v7 prisma version)
  moduleFormat    = "cjs"
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// profile picture is missing
model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String         @unique
  birthday       DateTime
  password       String
  biography      String?
  homeLocationId Int
  homeLocation   Location       @relation(fields: [homeLocationId], references: [id])
  preferences    Preference[]
  posts          Post[]
  postsLiked     PostLiked[]
  postsDisliked  PostDisliked[]
  // prisma es una mierda, ejemplo 1:
  friendsAsUser1 Friends[]      @relation("friend1")
  friendsAsUser2 Friends[]      @relation("friend2")

  comments  Comment[]
  postScore PostScore[]

  events       Event[]
  eventSignUp  EventSignUp[]
  eventEntries EventEntry[]
  savedEvents  SavedEvent[]

  groupMember GroupMember[]
  embedding   Unsupported("vector(3072)")?
  isVerified  Boolean                      @default(false)
}

model Sport {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  preferences Preference[]
  postSport   PostSport[]

  events Event[]
}

model Preference {
  id      Int    @id @default(autoincrement())
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)
  sportId Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  level   String

  // hace que la combinacion user-sport sea unica
  @@unique([userId, sportId])
}

model Location {
  id        Int    @id @default(autoincrement())
  location  String @unique
  latitude  Float
  longitude Float

  users  User[]
  events Event[]
}

model Post {
  id            Int            @id @default(autoincrement())
  content       String
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  postsLiked    PostLiked[]
  postsDisliked PostDisliked[]
  comments      Comment[]
  postSport     PostSport[]
  postScore     PostScore[]

  imagePosts ImagePost[]
}

model PostLiked {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@unique([postId, userId])
}

model PostDisliked {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@unique([postId, userId])
}

model Friends {
  id       Int    @id @default(autoincrement())
  user1    User   @relation("friend1", fields: [sender], references: [id], onDelete: Cascade)
  sender   Int
  user2    User   @relation("friend2", fields: [receiver], references: [id], onDelete: Cascade)
  receiver Int
  state    String

  @@unique([sender, receiver])
}

model Comment {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  parentId  Int?
  parent    Comment?  @relation("parent", fields: [parentId], references: [id])
  comments  Comment[] @relation("parent")
  content   String
  createdAt DateTime  @default(now())
}

model PostSport {
  id      Int   @id @default(autoincrement())
  post    Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  Int
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  sportId Int

  @@unique([postId, sportId])
}

model PostScore {
  id         Int  @id @default(autoincrement())
  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  sportMatch Int  @default(0)

  @@unique([userId, postId])
}

model Image {
  id       Int     @id @default(autoincrement())
  url      String?
  content  Bytes?
  mimeType String?

  imagePosts   ImagePost[]
  imageEvents  ImageEvent[]
  imageEntry   ImageEntry[]
  imageGroup   Group[]
  imageMessage ImageMessage[]
}

model ImagePost {
  id      Int   @id @default(autoincrement())
  imageId Int
  image   Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  postId  Int
  post    Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([imageId, postId])
}

model ImageEvent {
  id Int @id @default(autoincrement())

  imageId Int
  image   Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  description String

  @@unique([imageId, eventId])
}

model ImageMessage {
  id Int @id @default(autoincrement())

  imageId Int
  image   Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([imageId, messageId])
}

model Event {
  id           Int                          @id @default(autoincrement())
  hostId       Int
  host         User                         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title        String
  description  String
  chatId       Int? // falta la tabla chat
  createdAt    DateTime                     @default(now())
  startingDate DateTime
  locationId   Int?
  location     Location?                    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  endingDate   DateTime?
  eventType    EventType
  imageEvents  ImageEvent[]
  eventSignUp  EventSignUp[]
  isPrivate    Boolean
  sportId      Int
  sport        Sport                        @relation(fields: [sportId], references: [id], onDelete: Cascade)
  eventEntries EventEntry[]
  savedEvents  SavedEvent[]
  embedding    Unsupported("vector(3072)")?
}

enum EventType {
  Asynchronous
  InPerson
}

model EventSignUp {
  id       Int       @id @default(autoincrement())
  eventId  Int
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state    String
  joinedAt DateTime?

  @@unique([userId, eventId])
}

model EventEntry {
  id        Int          @id @default(autoincrement())
  eventId   Int
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime     @default(now())
  images    ImageEntry[]
}

model ImageEntry {
  id      Int        @id @default(autoincrement())
  imageId Int
  image   Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  entryId Int
  entry   EventEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Group {
  id           Int           @id @default(autoincrement())
  name         String
  description  String
  imageId      Int?
  image        Image?        @relation(fields: [imageId], references: [id], onDelete: Cascade)
  groupMembers GroupMember[]

  messages Message[]
}

model GroupMember {
  id       Int       @id @default(autoincrement())
  userId   Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  Int
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isAdmin  Boolean
  messages Message[]

  @@unique([groupId, userId])
}

model Message {
  id            Int            @id @default(autoincrement())
  groupId       Int
  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content       String
  groupMemberId Int
  groupMember   GroupMember    @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  date          DateTime
  images        ImageMessage[]
}

model SavedEvent {
  id      Int   @id @default(autoincrement())
  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}
