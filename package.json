{
  "name": "monorepo-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:studio": "npm run prisma:studio -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:push": "npm run prisma:push -w backend",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend --debug --watch",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "prisma:seed": "npm run prisma:seed -w backend"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/schedule": "^6.1.3",
    "handlebars": "^4.7.9",
    "nodemailer": "^9.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cron": "^2.0.1",
    "@types/nodemailer": "^8.0.1"
  }
}
