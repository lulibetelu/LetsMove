// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  //output   = "../generated/prisma"
  //added because of nest-prisma documentation (v7 prisma version)
  moduleFormat    = "cjs"
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

//profile picture is missing
model User{
  id Int  @default(autoincrement()) @id
  username String @unique
  email String @unique
  password String
  biography String?
  preferences Preference[] @ignore
  userLocations UserLocation[] @ignore
  posts Post[]
  postsLiked PostLiked[] @ignore
  postsDisliked PostDisliked[] @ignore
  //prisma es una mierda, ejemplo 1:
  friendsAsUser1 Friends[]      @relation("friend1") @ignore
  friendsAsUser2 Friends[]      @relation("friend2") @ignore
}

model Sport{
  id Int  @default(autoincrement()) @id
  name String @unique
  preferences Preference[] @ignore
}

model Preference{
  id Int  @default(autoincrement()) @id
  sport Sport @relation(fields: [sportId], references: [id])
  sportId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  level String
  //hace que la combinacion user-sport sea unica
  @@unique([userId, sportId])
}

model UserLocation{
  id Int  @default(autoincrement()) @id
  user User @relation(fields: [userId], references: [id])
  userId Int
  location Location @relation(fields: [locationId], references: [id])
  locationId Int
}

model Location{
  id Int  @default(autoincrement()) @id
  location String
  latitude Float
  longitude Float
  userLocations UserLocation[] @ignore
}

model Post{
  id Int @default(autoincrement()) @id
  content String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId Int
  postsLiked PostLiked[]
  postsDisliked PostDisliked[]
}

model PostLiked {
  id Int @default(autoincrement()) @id
  post Post @relation(fields: [postId], references: [id])
  postId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  @@unique([postId, userId])
}

model PostDisliked {
  id Int @default(autoincrement()) @id
  post Post @relation(fields: [postId], references: [id])
  postId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  @@unique([postId, userId])
}

model Friends {
  id Int @default(autoincrement()) @id
  user1 User @relation("friend1", fields: [userId1], references: [id])
  userId1 Int
  user2 User @relation("friend2", fields: [userId2], references: [id])
  userId2 Int
  @@unique([userId1, userId2])
  state String
}